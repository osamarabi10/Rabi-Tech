# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rabitech

# Redis
REDIS_URL=redis://localhost:6379

# OpenWA
OPENWA_URL=http://localhost:3000
OPENWA_API_KEY=your-openwa-api-key-here
CHANNEL_ENCRYPTION_KEY=generate-at-least-32-random-characters
GATEWAY_PORT_START=3100
GATEWAY_PORT_END=3999
GATEWAY_BACKEND_HOST=host.docker.internal
GATEWAY_HOST_ACCESS=127.0.0.1
BACKEND_INTERNAL_URL=http://host.docker.internal:4000
GATEWAY_WORKER_CONCURRENCY=4
INCOMING_MESSAGE_CONCURRENCY=8
CAMPAIGN_WORKER_CONCURRENCY=8
# Optional operational ceilings. Plan rates are defined in billing/plans.ts.
CAMPAIGN_RATE_HARD_MAX=
CAMPAIGN_RATE_MIN_DURATION_MS=

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# RabiTech platform owner (development seed)
PLATFORM_OWNER_EMAIL=owner@rabitech.co.il
# Set before seeding. Left empty on purpose: this file is public, and a
# working default here is a credential rather than a placeholder.
PLATFORM_OWNER_PASSWORD=

# WhatsApp Sessions
IT_SESSION_NAME=it-support
MARKETING_SESSION_NAME=marketing
IT_NUMBER=972XXXXXXXXX
MARKETING_NUMBER=972XXXXXXXXX

# Alerts
IT_ALERT_GROUP_ID=972XXXXXXXXX-XXXXXXXXXX@g.us

# App
FRONTEND_URL=http://localhost:8080
NEXT_PUBLIC_SUPPORT_EMAIL=owner@rabitech.co.il
# Optional public destinations. Empty entries stay visible in Help with an
# explicit unavailable reason rather than opening a fake or broken page.
NEXT_PUBLIC_VIDEO_GUIDES_URL=
NEXT_PUBLIC_DEVELOPER_DOCS_URL=
NEXT_PUBLIC_REFERRAL_URL=
NEXT_PUBLIC_STATUS_URL=
NEXT_PUBLIC_PRIVACY_URL=
PORT=4000
NODE_ENV=development

# Durable workspace assets
SNIPPET_UPLOAD_DIR=/app/uploads/snippets

# Scheduled subscriber reports
DISABLE_WEEKLY_RECAP_WORKER=0
WEEKLY_RECAP_CRON=10 * * * *

# Database backups.
# The nightly dump is verified by restoring it; these control the copy that
# leaves the host, which is a separate thing and off by default.
BACKUP_KEEP=14
BACKUP_CRON=20 3 * * *
# Where the encrypted copy goes. Unset means replication is off and every
# verified dump stays on this host only — which is the state to fix before a
# real customer, not after.
BACKUP_REPLICA_DIR=
# Assert that the path above is genuinely a different device. Nothing inside
# the process can tell a mounted drive from a sibling folder, so this is the
# operator's word, and the boot log warns while it is not 1.
BACKUP_REPLICA_OFFHOST=0
# At least 32 characters. WRITE THIS DOWN SOMEWHERE THAT IS NOT THIS MACHINE —
# a password manager. An encrypted off-host backup whose only key lives in the
# .env that dies with the host is ciphertext, not a backup.
# Deliberately separate from CHANNEL_ENCRYPTION_KEY: different blast radius.
# Unset means nothing is uploaded. Dumps are never sent in plaintext.
BACKUP_ENCRYPTION_KEY=
# The weekly drill downloads the newest copy, decrypts it and restores it.
BACKUP_DRILL_CRON=50 3 * * 0
# A copy older than this fails the drill even when it restores cleanly:
# replication that stopped silently is the failure worth catching.
BACKUP_REPLICA_MAX_AGE_HOURS=48

# Meta WhatsApp Cloud API (bring-your-own-token).
#
# Customers supply their own Phone Number ID, WABA ID and System User token
# through /settings/channels; those are stored per tenant and are NOT set here.
# These three are the platform's own app-level values.
#
# META_APP_SECRET signs every inbound webhook. Leave it unset and the webhook
# fails closed - every delivery is rejected rather than trusted - because an
# unsigned endpoint anyone can POST to is a way to inject messages into any
# tenant.
META_APP_SECRET=
# Echoed back to Meta once, when the callback URL is registered.
META_WEBHOOK_VERIFY_TOKEN=
# Optional. Overrides the pinned Graph version; leave empty to use the version
# the webhook parser and send path were written against.
META_GRAPH_VERSION=

# ── Stripe, test mode ────────────────────────────────────────────────────────
#
# Names only; never commit real values. Test mode needs no verified business
# and moves no money, so the whole signup-to-active path can be proven with
# these before any live key exists.
#
# PAYMENT_PROVIDER stays `manual` until you deliberately switch it. Setting it
# to `stripe` with any of the below unset fails loudly at the point of use
# rather than silently rejecting every webhook.
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
# From `stripe listen`, or the endpoint's signing secret in the dashboard.
# Without it verifyWebhook rejects every event as unsigned.
STRIPE_WEBHOOK_SECRET=
#
# Our plan code to a Stripe price id, one per sellable edition. Price ids are
# per-environment: a test-mode `price_...` is not the live one, which is why
# these live here and not in the repository.
#
# An edition with no entry refuses at checkout. That is deliberate - falling
# back to another edition's price charges the wrong amount for the wrong thing,
# and the customer finds out from their bank statement. It is also why the
# closed plan-code space matters operationally: an edition created from the
# console today would have no price here and could be listed but not sold.
# Keyed by edition AND interval. On Stripe's side the billing interval is part
# of what a Price is, not a modifier applied to one, so a yearly edition needs
# its own Price id. Every edition is MONTHLY today; the YEARLY names exist so
# that switching one is configuration rather than a code change.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
