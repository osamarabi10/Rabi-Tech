# Database
DATABASE_URL=postgresql://admin:secret@localhost:5432/rabitech

# Redis
REDIS_URL=redis://localhost:6379

# OpenWA
OPENWA_URL=http://localhost:3000
OPENWA_API_KEY=your-openwa-api-key-here
CHANNEL_ENCRYPTION_KEY=generate-at-least-32-random-characters
GATEWAY_PORT_START=3100
GATEWAY_PORT_END=3999
GATEWAY_BACKEND_HOST=host.docker.internal
GATEWAY_HOST_ACCESS=127.0.0.1
BACKEND_INTERNAL_URL=http://host.docker.internal:4000
GATEWAY_WORKER_CONCURRENCY=4
INCOMING_MESSAGE_CONCURRENCY=8
CAMPAIGN_WORKER_CONCURRENCY=8
# Optional operational ceilings. Plan rates are defined in billing/plans.ts.
CAMPAIGN_RATE_HARD_MAX=
CAMPAIGN_RATE_MIN_DURATION_MS=

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# RabiTech platform owner (development seed)
PLATFORM_OWNER_EMAIL=owner@rabitech.co.il
# Set before seeding. Left empty on purpose: this file is public, and a
# working default here is a credential rather than a placeholder.
PLATFORM_OWNER_PASSWORD=

# WhatsApp Sessions
IT_SESSION_NAME=it-support
MARKETING_SESSION_NAME=marketing
IT_NUMBER=972XXXXXXXXX
MARKETING_NUMBER=972XXXXXXXXX

# Alerts
IT_ALERT_GROUP_ID=972XXXXXXXXX-XXXXXXXXXX@g.us

# App
FRONTEND_URL=http://localhost:8080
NEXT_PUBLIC_SUPPORT_EMAIL=owner@rabitech.co.il
# Optional public destinations. Empty entries stay visible in Help with an
# explicit unavailable reason rather than opening a fake or broken page.
NEXT_PUBLIC_VIDEO_GUIDES_URL=
NEXT_PUBLIC_DEVELOPER_DOCS_URL=
NEXT_PUBLIC_REFERRAL_URL=
NEXT_PUBLIC_STATUS_URL=
NEXT_PUBLIC_PRIVACY_URL=
PORT=4000
NODE_ENV=development

# Durable workspace assets
SNIPPET_UPLOAD_DIR=/app/uploads/snippets

# Scheduled subscriber reports
DISABLE_WEEKLY_RECAP_WORKER=0
WEEKLY_RECAP_CRON=10 * * * *
