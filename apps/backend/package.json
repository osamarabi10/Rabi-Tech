{
  "name": "rabitech-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc && npm run lint",
    "start": "node dist/index.js",
    "lint": "node scripts/lint-prisma-client.js",
    "test:tenancy": "node scripts/tenancy-bleed-harness.js",
    "test:finance": "npm run build && node scripts/verify-finance.js",
    "test:snooze": "npm run build && node scripts/verify-snooze-wake.js",
    "usage:backfill": "ts-node scripts/backfill-usage-rollups.ts",
    "gateway:worker": "ts-node src/workers/gateway-provisioning.worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "platform:bootstrap-owner": "ts-node scripts/bootstrap-platform-owner.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.6.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
    "socket.io-client": "^4.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
