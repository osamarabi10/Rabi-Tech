  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, userId, revokedAt])
  @@index([lastSeenAt])
}

/// A bearer token for the public API (P1).
///
/// ## Scoped and expiring, deliberately
///
/// Respond.io's own developer documentation records the alternative as a gap:
/// "No expiry, rotation, revocation procedure or scoping mechanism is
/// documented anywhere… the token is workspace-wide." A workspace-wide eternal
/// token is a single credential that can read every conversation a subscriber
/// has ever had, and retrofitting auth is the most expensive change in
/// software — so scopes and an expiry exist from the first row.
///
/// ## The secret is never stored
///
/// `tokenHash` is SHA-256 of the secret half. Not bcrypt: this is a
/// high-entropy random value rather than a human password, so a slow KDF buys
/// nothing against brute force and costs a hash on every API request.
///
/// `prefix` is the public half, stored in clear so a token can be identified
/// in a list and looked up in one indexed query without hashing every row.
/// The full token is shown to the operator exactly once, at creation.
model ApiToken {
  id             String    @id @default(cuid())
  organizationId String
  /// What the operator called it. Shown wherever the token is listed.
  name           String
  /// Public half — `rbt_<prefix>`. Unique platform-wide so lookup needs no
  /// tenant hint: an inbound request carries a token and nothing else.
  prefix         String    @unique
  /// SHA-256 of the secret half, hex.
  tokenHash      String
  /// Operations this token may perform, e.g. `contacts:read`.
  /// Empty is not "everything" — it is "nothing", and the middleware treats it
  /// that way. A scope list that defaults open is how a restricted credential
  /// becomes an unrestricted one by omission.
  scopes         String[]  @default([])
  /// Null means no expiry. Permitted, because an integration nobody maintains
  /// is worse than one that keeps working — but the console warns, and the
  /// creation form defaults to 90 days.
  expiresAt      DateTime?
  revokedAt      DateTime?
  /// Written on use, at most once a minute. An unused token is the strongest
  /// signal that a credential can be revoked safely.
  lastUsedAt     DateTime?
  /// Inherited from the creating user's `maskPhoneAndEmail` at issue time.
  ///
  /// A token must not see what the person who minted it cannot. Frozen rather
  /// than resolved live through `createdById`, because that column is nullable
  /// and the creator can be deleted — a token whose masking depended on a row
  /// that may not exist would unmask itself the day that user is removed.
  maskContactDetails Boolean @default(false)
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiTokenCreatedBy", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, revokedAt])
}

/// Recipients are memberships, not loose email strings. The composite foreign
/// key prevents a workspace from attaching another tenant's user to its recap.
model WeeklyRecapRecipient {
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([organizationId, createdAt])
}

