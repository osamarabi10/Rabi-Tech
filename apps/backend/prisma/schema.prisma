generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Global, non-tenant models
model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique // for Phase 1.5 subdomain routing
  status               String    @default("ACTIVE") // ACTIVE|SUSPENDED|PROVISIONING
  tier                 String    @default("FREE") // FREE|STANDARD|GROWTH|BUSINESS|ENTERPRISE
  paymentProvider      String    @default("manual")
  paymentCustomerRef   String?
  emailVerifiedAt      DateTime?
  /// Service stops at this moment unless the balance is cleared first.
  ///
  /// The promise made to a subscriber who is late: you keep working until
  /// then. Null for everyone not in dunning, which is nearly everyone.
  suspendAt            DateTime?
  suspendReason        String?
  downgradeGraceEndsAt DateTime?
  downgradeGraceReason String?

  /// Platform-owner commercial overrides (P9). Resolved at read time by
  /// modules/billing/entitlements.resolver.ts and NEVER mirrored into OrganizationConfig —
  /// see the migration comment for why. planOverride mirrors PlanCode in
  /// modules/billing/plans.ts and is constrained in SQL; keep the two in step.
  planOverride      String?
  /// Monthly Active Contacts only. MAC is the commercial billing unit; the
  /// other five meters follow the effective plan, because one integer cannot
  /// mean both active_contacts (~2.5k) and ai_tokens_in (~millions).
  macQuotaOverride  Int?
  discountPercent   Int?
  creditCents       Int       @default(0)
  overrideReason    String?
  overrideExpiresAt DateTime?
  /// Identity.id of the platform owner who set it. No FK: an audit trail must
  /// outlive the actor.
  overrideSetBy     String?
  overrideSetAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  teams                   Team[]
  userTeams               UserTeam[]
  contacts                Contact[]
  conversations           Conversation[]
  campaigns               Campaign[]
  templates               MessageTemplate[]
  metaMessageTemplates    MetaMessageTemplate[]
  metaTemplateSends       MetaTemplateSend[]
  snippetTopics           SnippetTopic[]
  snippetTopicAssignments SnippetTopicAssignment[]
  snippetAttachments      SnippetAttachment[]
  whatsappSessions        WhatsappSession[]
  csatResponses           CsatSurveyResponse[]
  auditLogs               AuditLog[]
  campaignRecipients      CampaignRecipient[]
  keywords                Keyword[]
  notifications           Notification[]
  configuration           OrganizationConfig?
  branding                OrganizationBranding?
  workingHours            WorkingHours?
  sequences               OrgSequence[]
  channels                OrganizationChannel[]
  metaCredentials         MetaChannelCredential[]
  usageEvents             UsageEvent[]
  dailyMetrics            PlatformDailyMetric[]
  platformAlerts          PlatformAlert[]
  tags                    Tag[]
  contactTags             ContactTag[]
  customFieldDefinitions  CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  contactFieldPreferences ContactFieldPreference[]
  conversationCategories  ConversationCategory[]
  conversationClosures    ConversationClosure[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  paymentReceipts         PaymentReceipt[]
  emailVerificationTokens EmailVerificationToken[]
  signupThrottleEvents    SignupThrottleEvent[]
  segments                Segment[]
  healthChecks            GatewayHealthCheck[]
  workflows               Workflow[]
  workflowExecutions      WorkflowExecution[]
  authSessions            AuthSession[]
  apiTokens               ApiToken[]
  webhookEndpoints        WebhookEndpoint[]
  conversationCollaborators ConversationCollaborator[]
  weeklyRecapRecipients   WeeklyRecapRecipient[]
  userInvitations         UserInvitation[]

  /// The console sweeps for live and expiring overrides on every load.
  analyticsHourly AnalyticsHourly[]

  webhookDeliveryLogs WebhookDeliveryLog[]

  lifecycleStages LifecycleStage[]

  inboxViews InboxView[]

  emailOutbox EmailOutbox[]

  @@index([overrideExpiresAt])
}

/// The edition catalogue. Until now this row was a projection of the
/// PLAN_ENTITLEMENTS constant and carried only price and name; the limits and
/// features that decide what a subscriber may actually do lived in code, so
/// repricing a tier meant a deploy. These columns move that decision into the
/// database so the platform owner can change the menu, not just grant one
/// customer an exception.
///
/// Every entitlement column is nullable or defaulted, so the rows that already
/// exist stay valid and the seed can fill them in a separate, reviewable step.
/// A null limit means unlimited, matching the constant it replaces.
/// How an edition is priced, which `monthlyPriceCents` alone cannot say.
///
/// FREE and NEGOTIATED were both stored as 0, so "costs nothing" and "price is
/// agreed per deal and not published" were indistinguishable — and `isPaidPlan`
/// had to decide by *name* instead, which is why FREE was a reserved code.
///
/// FREE        price is 0 and that is the offer.
/// FIXED       price is published and self-serve.
/// NEGOTIATED  price is agreed per deal; the stored number means nothing.
/// How often a subscriber on this edition is charged.
///
/// Distinct from the usage month. Every monthly* limit resets per calendar
/// month via monthRange() whatever this says — a yearly subscription still
/// meters monthly, and giving it twelve months of allowance on day one is not
/// what anyone is selling.
enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PricingModel {
  FREE
  FIXED
  NEGOTIATED
}

model Plan {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  monthlyPriceCents Int
  /// Read this before the price. See PricingModel.
  pricingModel      PricingModel    @default(FIXED)
  /// How often monthlyPriceCents is charged. That column's name predates
  /// yearly billing and now means "amount per interval"; the rename is real
  /// debt, deliberately unpaid — 52 references across 11 files and the API
  /// boundary, for no behaviour change.
  billingInterval   BillingInterval @default(MONTHLY)
  currency          String          @default("USD")
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)

  /// Metered allowances. Null means unlimited.
  monthlyActiveContactsLimit   Int?
  monthlyOutboundMessagesLimit Int?
  monthlyCampaignSendsLimit    Int?
  customFieldsLimit            Int?
  usersLimit                   Int?
  workflowsLimit               Int?

  /// AI allowances. Null means unlimited, as with every limit above.
  ///
  /// These are the only two metered meters that had no edition column at all:
  /// they lived solely on OrganizationConfig with no write path, so AI was
  /// negotiated per deal or not offered, and could not be part of what an
  /// edition sells. BigInt because token counts run to millions where the
  /// message meters run to thousands.
  ///
  /// Shipped null on every edition, which is exactly what the config already
  /// held — the lever is added without setting a policy with it.
  monthlyAiTokensInLimit  BigInt?
  monthlyAiTokensOutLimit BigInt?

  /// Broadcast pacing. OpenWA drives WhatsApp Web, so blasting risks a ban.
  campaignRateMax        Int?
  campaignRateDurationMs Int?

  /// Feature grants. Each must have exactly one server-side enforcement site
  /// reading the resolved edition — a toggle that grants nothing is worse than
  /// no toggle, because it looks like it worked.
  customDomain       Boolean @default(false)
  whiteLabel         Boolean @default(false)
  maskContactDetails Boolean @default(false)

  /// Enforced at activation: billing.service.ts consults this before queueing a
  /// gateway provision.
  ///
  /// It was previously stored and NOT read, while the actual decision was a
  /// hidden `isPaidPlan(planCode)` name check sitting beside it. The two
  /// disagreed on STANDARD — flag false, name check true — so a subscriber
  /// could have had a gateway provisioned while the console hid the switch
  /// that supposedly governed it.
  autoProvisionGateway Boolean @default(false)

  /// Channel kinds this edition may connect, matching OrganizationChannel.kind.
  /// A list, not a single value, because an edition may offer a choice.
  ///
  /// Enforced in channels.routes.ts, on both connect and activate. It shipped
  /// identical on every edition, read by nothing, with the PATCH endpoint
  /// refusing to set it — three separate signals that it granted nothing.
  ///
  /// Widened to both kinds when enforcement landed: the Meta kind is
  /// WHATSAPP_CLOUD and no edition listed it, so checking the shipped {OPENWA}
  /// would have withdrawn Meta from every subscriber rather than adding a
  /// capability. Narrowing an edition is now an owner decision.
  allowedChannels String[] @default(["OPENWA"])

  /// Withdrawn from the console entirely. Strictly stronger than `isActive`,
  /// which only withdraws an edition from sale.
  ///
  /// Three states, and all three resolve: active (sold, listed), inactive
  /// (not sold, still listed so the owner can bring it back), archived (not
  /// sold, not listed). A subscriber on an archived edition keeps exactly the
  /// entitlements it grants — archiving is an editorial act on the catalogue,
  /// never a change to what anyone already bought.
  ///
  /// Implemented by filtering the *published* set, never the query that loads
  /// the cache. `refreshEditions` must keep reading every row: an archived
  /// edition dropped from the cache resolves to RESTRICTED_FLOOR, which grants
  /// nothing and returns 200 while doing it.
  archivedAt DateTime?

  /// A pending edit, in the shape of a PATCH body, applied by refreshEditions
  /// once scheduledFrom has passed and cleared when it is.
  ///
  /// Two columns rather than a revision table because getEdition() is
  /// synchronous and nineteen call sites depend on that. The refresh resolves
  /// what is in force; the accessor stays a map lookup. A schedule therefore
  /// lands up to one refresh interval late, which is the right trade for a
  /// change dated to a day.
  scheduledChanges Json?
  scheduledFrom    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

/// Meta WhatsApp Cloud API credentials for one organization's channel.
///
/// Bring-your-own-token: the customer creates their own Meta Business account,
/// obtains their own number, generates a System User token, and supplies it
/// here. RabiTech has no Meta billing relationship - see OQ-1 in
/// docs/RABITECH-PRODUCT-VISION.md.
///
/// **What is secret and what is not.** The access token is the credential: it
/// sends as that business, so losing one is impersonating a company to its own
/// customers. It is encrypted at rest and never returned by any endpoint.
/// phoneNumberId and wabaId are *identifiers*, not secrets - Meta puts the
/// phone number id in the body of every inbound webhook, so it is already
/// public to anyone Meta talks to, and knowing it grants nothing. They are
/// stored in plaintext because the webhook has to resolve an organization from
/// phoneNumberId on every inbound message, and an encrypted column cannot be
/// looked up.
///
/// **phoneNumberId is globally unique, deliberately.** It is the only key the
/// inbound webhook has - Meta posts every customer's messages to one URL - so
/// exactly one organization may claim a given number. Two rows sharing it would
/// make tenant resolution ambiguous, which on this path means delivering one
/// business's customer messages into another business's inbox. The database
/// refuses that rather than the application checking for it.
model MetaChannelCredential {
  id             String @id @default(cuid())
  organizationId String
  channelId      String

  /// Identifiers, not secrets. See the note above.
  phoneNumberId       String
  wabaId              String
  /// Meta Business Portfolio ID. Nullable while existing connections are
  /// repaired; globally unique so a portfolio can never be shared by tenants.
  businessPortfolioId String?

  /// The credential. AES-256-GCM via lib/credential-crypto, never read back.
  accessTokenEnc String

  /// Which encryption key this row was sealed with.
  ///
  /// CHANNEL_ENCRYPTION_KEY has no rotation routine today, and rotating it
  /// would orphan every encrypted row. That is survivable for an OpenWA gateway
  /// key; it is not survivable for a vault of other businesses' tokens, where
  /// the only remedy would be asking every customer to re-enter credentials.
  /// The column exists so a future re-encryption can tell which rows it has
  /// already migrated. Rotation itself remains out of scope - making it
  /// possible later is a different thing from building it now, and retrofitting
  /// this column across live encrypted rows is expensive.
  keyVersion Int @default(1)

  /// ACTIVE | INVALID | PENDING. Tokens die on their own - a password change, a
  /// permission revoke, or the System User being deleted - so a credential that
  /// worked yesterday is not assumed to work today.
  status          String    @default("PENDING")
  invalidReason   String?
  lastValidatedAt DateTime?

  /// Non-secret display values read back from Meta, so the console can show
  /// which number is connected without decrypting anything.
  displayPhoneNumber String?
  verifiedName       String?
  qualityRating      String?
  messagingTier      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      OrganizationChannel @relation(fields: [channelId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([phoneNumberId])
  @@unique([wabaId])
  @@unique([businessPortfolioId])
  @@unique([channelId, organizationId])
  @@index([organizationId, status])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planCode           String
  provider           String             @default("manual")
  subscriptionRef    String?            @unique
  customerRef        String?
  externalRef        String?
  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  activatedAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planCode], references: [code], onDelete: Restrict)
  invoices     Invoice[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([provider, customerRef])
  @@index([provider, subscriptionRef])
  @@index([provider, externalRef])
}

model Invoice {
  id               String    @id @default(cuid())
  organizationId   String
  subscriptionId   String?
  provider         String    @default("manual")
  /// Allocated from OrgSequence("invoiceRef") inside the transaction that
  /// creates the invoice. Never reused; see finance.service.ts.
  invoiceRef       String
  customerRef      String?
  /// OPEN | PAID | VOID. Invoices are voided, never deleted.
  status           String    @default("OPEN")
  amountDueCents   Int       @default(0)
  amountPaidCents  Int       @default(0)
  currency         String    @default("USD")
  hostedInvoiceUrl String?
  dueAt            DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription?    @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  receipts     PaymentReceipt[]

  @@unique([id, organizationId])
  /// Scoped to the organization that issued it (D-28), which is what a
  /// reference here actually promises.
  ///
  /// This was `@@unique([provider, invoiceRef])`, which let one reference exist
  /// twice under two providers — the collision a reference exists to rule out.
  /// The fix for that was right; making it global was an over-correction, and
  /// it created a dependency nobody intended.
  ///
  /// The sequence behind the reference is per organization
  /// (`OrgSequence("invoiceRef")`), so under a global constraint the only thing
  /// separating two organizations' identical sequence numbers was the four-char
  /// id tail in the format. Two organizations sharing a tail collided the first
  /// time both reached the same number, and because the constraint is a hard
  /// unique the symptom was **an owner unable to issue an invoice at all** — an
  /// outage for one subscriber, arriving on an ordinary action. By birthday
  /// arithmetic that stops being unlikely in the low hundreds of organizations.
  ///
  /// `(organizationId, invoiceRef)` still rules out the original defect: one
  /// reference cannot exist twice within an organization, whatever the provider.
  /// It gives up only cross-organization uniqueness, which nothing uses — every
  /// one of `invoiceRef`'s call sites writes it at creation, reads it for
  /// display, or passes it to a provider as metadata. Nothing looks an invoice
  /// up by reference, so there is no path that could receive the wrong row.
  ///
  /// **What a reference promises: unique within the organization that issued
  /// it, and always quoted in that context.**
  @@unique([organizationId, invoiceRef])
  @@index([organizationId, createdAt])
  @@index([provider, customerRef])
}

/// Confirmation that money was taken, as opposed to Invoice, which records
/// what is owed.
///
/// Deliberately not a tax document: no sequential fiscal numbering, no VAT
/// breakdown, and the renderer states as much on the page. `reference` names
/// this system's own document and carries no fiscal meaning. Issuing anything
/// tax-valid needs a real accounting provider behind it.
model PaymentReceipt {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String?
  reference      String   @unique
  amountCents    Int      @default(0)
  currency       String   @default("USD")
  /// bank_transfer | cash | card | other. Free text on purpose: the platform
  /// owner settles however they settle, and a new method must not need a
  /// migration to record.
  method         String   @default("other")
  /// The payer's own reference — a transfer id, a cheque number.
  externalRef    String?
  note           String?
  paidAt         DateTime
  /// The platform actor who recorded it. Nullable: an imported or
  /// provider-driven payment has no human behind it.
  issuedByEmail  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, paidAt])
}

model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  processedAt DateTime @default(now())
  payload     Json?

  @@unique([provider, eventId])
  @@index([processedAt])
}

model EmailVerificationToken {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  tokenHash      String    @unique
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, consumedAt])
  @@index([email, createdAt])
}

model SignupThrottleEvent {
  id             String   @id @default(cuid())
  organizationId String?
  ipAddress      String
  emailDomain    String
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([ipAddress, createdAt])
  @@index([emailDomain, createdAt])
}

model Identity {
  id                  String    @id @default(cuid())
  email               String    @unique // globally unique for login
  passwordHash        String
  platformRole        String    @default("NONE") // NONE|SUPPORT|OWNER (optional: cross-org role)
  /// What a SUPPORT advisor may do, beyond reading.
  ///
  /// A list rather than more role names: support work is not a ladder. One
  /// advisor may need to extend trials and never touch billing, another the
  /// reverse, and every new shape of that would otherwise be a new role and a
  /// migration. Ignored for OWNER, who holds everything by definition.
  platformPermissions String[]  @default([])
  /// Set when a staff account is switched off.
  ///
  /// Disabling is not deleting: an advisor who leaves must stop being able to
  /// sign in while their name stays attached to everything they did. A deleted
  /// identity would take the audit trail with it.
  platformDisabledAt  DateTime?
  totpSecretEnc       String?
  totpEnabledAt       DateTime?
  totpLastUsedCounter BigInt?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users               User[]
  passwordResetTokens PasswordResetToken[]
  twoFactorChallenges TwoFactorChallenge[]
  recoveryCodes       IdentityRecoveryCode[]

  @@index([platformRole])
}

model TwoFactorChallenge {
  id         String    @id @default(cuid())
  identityId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, expiresAt])
}

model IdentityRecoveryCode {
  id         String    @id @default(cuid())
  identityId String
  codeHash   String    @unique
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, usedAt])
}

/// A message this system owes somebody, and has not yet managed to send.
///
/// A table rather than a direct call. Every message here is sent *because of*
/// something else succeeding — a payment failed, a trial ended, a password was
/// reset — and calling a mail API inline would make the provider's
/// availability a condition of that transaction committing. A mail outage
/// would start rolling back payment state.
model EmailOutbox {
  id             String    @id @default(cuid())
  /// Null for messages that belong to a person rather than a workspace:
  /// password resets, staff invitations, platform notices.
  organizationId String?
  toEmail        String
  /// Which message this is. Drives the template, and the deduplication.
  kind           String
  subject        String
  body           String
  /// PENDING | SENT | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  /// Do not send before this. Dunning sends one warning per stage rather than
  /// one per pass, and the retry backoff writes here too.
  sendAfter      DateTime  @default(now())
  /// "This exact message, once." A dunning warning carries the invoice and the
  /// stage, so a pass that runs twice cannot warn the same customer twice.
  /// Unique in the database, because enforcing it in application code means
  /// two workers can both decide it has not been sent yet.
  dedupeKey      String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, sendAfter])
  @@index([organizationId, createdAt])
}

/// A live password reset. Only the hash is stored, for the same reason a
/// password is: a readable table of reset tokens is a readable table of
/// account takeovers.
model PasswordResetToken {
  id          String    @id @default(cuid())
  identityId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  /// Single use. Recorded rather than deleted, so a second attempt can be told
  /// apart from a token that never existed.
  consumedAt  DateTime?
  /// For the notice that follows: "your password was changed from this
  /// address". Useless for prevention, decisive for detection.
  requestedIp String?
  createdAt   DateTime  @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, createdAt])
}

model OrganizationConfig {
  /// Whether an @mention also adds the mentioned person as a collaborator.
  ///
  /// A preference rather than a rule: on a small team a mention means "come
  /// help", on a large one it means "for your information". Defaults false —
  /// a mention that silently grants people a thread surprises whoever wrote it.
  mentionAddsCollaborator Boolean @default(false)
  organizationId               String          @id
  itSessionName                String          @default("it-support")
  marketingSessionName         String          @default("marketing")
  itNumber                     String?
  marketingNumber              String?
  sharedLine                   Boolean         @default(false)
  monthlyActiveContactsLimit   Int             @default(1000)
  monthlyInboundMessagesLimit  Int?
  monthlyOutboundMessagesLimit Int             @default(10000)
  monthlyCampaignSendsLimit    Int             @default(5000)
  monthlyAiTokensInLimit       BigInt?
  monthlyAiTokensOutLimit      BigInt?
  timezone                     String          @default("Asia/Jerusalem")
  /// Broadcasts hold outside these hours, in the *recipient's* local time.
  ///
  /// Off by default, and deliberately so: switching it on for existing
  /// subscribers would silently delay sends they have already scheduled, which
  /// is a behaviour change arriving as a surprise.
  ///
  /// The window is stored as local wall-clock strings rather than as UTC
  /// offsets because that is what an owner means. "No messages after nine"
  /// stays nine o'clock across a daylight-saving change; a stored offset would
  /// drift by an hour twice a year and nobody would connect the two.
  quietHoursEnabled            Boolean         @default(false)
  quietHoursStart              String          @default("21:00")
  quietHoursEnd                String          @default("08:00")
  userInactivityTimeoutMinutes Int             @default(20)
  weeklyRecapEnabled           Boolean         @default(false)
  autoCloseEnabled             Boolean         @default(false)
  autoCloseDurationMinutes     Int             @default(1440)
  autoCloseEnabledAt           DateTime?
  manualClosingNotesEnabled    Boolean         @default(false)
  manualClosingNoteMode        ClosingNoteMode @default(OPTIONAL)
  updatedAt                    DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Team {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  isDefault      Boolean @default(false)
  color          String  @default("#6366F1")
  emoji          String?

  /// NONE | ROUND_ROBIN | LEAST_OPEN. Automatic assignment for new conversations.
  assignmentStrategy    String @default("NONE")
  /// Max concurrent open conversations per agent. Null means unlimited.
  /// Without a cap, round-robin buries the fastest agent: they close quickly,
  /// so they always look free and keep receiving more.
  maxConcurrentPerAgent Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       UserTeam[]
  primaryUsers  User[]            @relation("UserPrimaryTeam")
  conversations Conversation[]
  sessions      WhatsappSession[]
  templates     MessageTemplate[]
  invitations   UserInvitation[]  @relation("InvitationPrimaryTeam")

  @@unique([id, organizationId])
  @@unique([organizationId, slug])
  @@index([organizationId, isDefault])
}

model UserTeam {
  organizationId String
  userId         String
  teamId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  team         Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([organizationId, userId, teamId])
  @@index([organizationId, teamId])
}

model OrganizationBranding {
  organizationId                String    @id
  productName                   String    @default("RabiTech")
  logoUrl                       String?
  faviconUrl                    String?
  primaryHsl                    String    @default("262 83% 63%")
  accentHsl                     String    @default("195 90% 60%")
  defaultLocale                 String    @default("ar")
  direction                     String    @default("rtl")
  customFooter                  String?
  customDomain                  String?   @unique
