model Conversation {
  id                  String             @id @default(cuid())
  organizationId      String
  displayId           Int
  contactId           String
  sessionId           String
  status              ConversationStatus @default(OPEN)
  teamId              String?
  assignedToId        String?
  lastMessageAt       DateTime?
  /// First human outbound reply. Auto-replies are excluded on purpose: counting
  /// them would report a first-response time of seconds for every thread.
  firstResponseAt     DateTime?
  /// Stamped at the RESOLVED transition and cleared on reopen, so it always
  /// describes the current resolution rather than the last edit of any kind.
  resolvedAt          DateTime?
  /// Start of the currently open episode. Reopening advances this timestamp;
  /// immutable ConversationClosure rows preserve earlier episodes.
  openedAt            DateTime           @default(now())
  /// Auto-close applies only to episodes opened while the workspace setting
  /// is enabled. Existing conversations are not silently enrolled.
  autoCloseEligible   Boolean            @default(false)
  /// Latest successful human customer-facing send. Internal notes, Workflows,
  /// Broadcasts, and automatic replies never start this timer.
  lastHumanOutboundAt DateTime?
  /// Persisted deadline makes the queue recoverable after a process restart.
  autoCloseAt         DateTime?
  isArchived          Boolean            @default(false)
  /// Snoozed while this is in the future, and simply not once it passes.
  ///
  /// A timestamp rather than a flag plus a job: nothing has to run for a
  /// conversation to come back, so there is no worker to fall over and no
  /// window where the row says one thing and the truth is another.
  ///
  /// Cleared when the customer replies. A thread the customer has just
  /// written to is the last thing this product should be hiding.
  snoozedUntil        DateTime?
  /// Who snoozed it. Denormalised so the activity entry stays readable after
  /// the user is deleted.
  snoozedByName       String?
  collaborators       ConversationCollaborator[]
  labels              String[]           @default([])
  pendingMenuChoice   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact               @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)
  session            WhatsappSession       @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  team               Team?                 @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignee           User?                 @relation(fields: [assignedToId, organizationId], references: [id, organizationId], onDelete: Restrict)
  messages           Message[]
  workflowExecutions WorkflowExecution[]
  csatResponse       CsatSurveyResponse?
  notifications      Notification[]
  closures           ConversationClosure[]

  @@unique([id, organizationId])
  @@unique([organizationId, displayId])
  @@index([organizationId, isArchived, status, lastMessageAt])
  @@index([organizationId, contactId, sessionId])
  @@index([organizationId, teamId])
  @@index([organizationId, resolvedAt])
  @@index([organizationId, firstResponseAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, autoCloseAt])
  @@index([organizationId, openedAt])
}

model ConversationCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

/// One immutable close episode. Categories and actors are snapshotted so
/// reports remain readable after a category is deleted or a user is renamed.
/// Somebody working a conversation who is not its assignee.
///
/// A thread has exactly one assignee and real work rarely does. A billing
/// question that needs the technical lead, a complaint a manager is reading
/// along on — today both are handled by reassigning, which loses the original
/// owner, or by @mentioning and hoping, which notifies once and leaves no state.
///
/// ## Their removal rule, copied whole
///
/// *"Any collaborator or the assignee can remove a collaborator — there's no
/// restriction on who can remove whom."* A permission model here is friction
/// with no benefit: the people on a thread are the people who can see who else
/// is on it, and nobody outside it cares.
model ConversationCollaborator {
  organizationId String
  conversationId String
  userId         String
  /// Nullable: a workflow or an @mention can add somebody, and neither is a user.
  addedById      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user         User         @relation("CollaboratorUser", fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  addedBy      User?        @relation("CollaboratorAddedBy", fields: [addedById, organizationId], references: [id, organizationId], onDelete: SetNull)

  /// The pair is the identity — one person is on a thread once. A surrogate id
  /// would allow duplicates and make the nine-collaborator cap meaningless.
  @@id([organizationId, conversationId, userId])
  @@index([organizationId, userId])
}

model ConversationClosure {
  id             String                    @id @default(cuid())
  organizationId String
  conversationId String
  categoryId     String?
  categoryName   String?
  summary        String?
  source         ConversationClosingSource
  closedById     String?
  closedByName   String?
  openedAt       DateTime
  closedAt       DateTime                  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, closedAt])
  @@index([organizationId, categoryName, closedAt])
  @@index([organizationId, source, closedAt])
  @@index([organizationId, closedById, closedAt])
  @@index([organizationId, conversationId, closedAt])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  conversationId String
  waMessageId    String?
  direction      MessageDirection
  status         MessageStatus    @default(PENDING)
  /// Why the last send attempt failed, in the words the agent is shown.
  /// NULL on anything that has not failed, and on failures predating it.
  failureReason  String?
  body           String?
  mediaUrl       String?
  mediaType      String?
  mediaFileName  String?
  isAuto         Boolean          @default(false)
  autoType       String?
  isInternal     Boolean          @default(false)
  isRead         Boolean          @default(false)
  sentById       String?
  timestamp      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentById, organizationId], references: [id, organizationId], onDelete: Restrict)

  // Composite unique: waMessageId per org
  @@unique([organizationId, waMessageId])
  @@index([organizationId, conversationId, timestamp])
  @@index([organizationId, conversationId, direction, isRead])
}

model Campaign {
  id                   String         @id @default(cuid())
  organizationId       String
  sessionId            String
  title                String
  message              String
  mediaUrl             String?
  status               CampaignStatus @default(DRAFT)
  scheduledAt          DateTime?
  sentAt               DateTime?
  createdAt            DateTime       @default(now())
  /// ContactFilterDsl used to resolve recipients. Null = every non-archived contact.
  /// Stored so a campaign's audience stays auditable after the fact.
  audienceFilter       Json?
  /// Provider-owned Meta template used by a future Meta campaign sender.
  /// This phase stores the binding only; it does not send anything.
  metaTemplateId       String?
  metaTemplateBindings Json?

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session           WhatsappSession      @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  recipients        CampaignRecipient[]
  metaTemplate      MetaMessageTemplate? @relation(fields: [metaTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  metaTemplateSends MetaTemplateSend[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

model MessageTemplate {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  body           String
  shortCode      String?
  category       TemplateCategory @default(QUICK_REPLY)
  /// When set, this template IS the organization's configured auto-reply for that event.
  /// No kind configured (or inactive) means the auto-reply is simply not sent.
  autoReplyKind  AutoReplyKind?
  /// Deprecated legacy ISP template column. teamId is the source of truth.
  teamId         String?
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team                Team?                    @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workingHoursOoh     WorkingHours[]           @relation("OutOfHoursTemplate")
  workingHoursWelcome WorkingHours[]           @relation("WelcomeTemplate")
  snippetTopics       SnippetTopicAssignment[]
  attachments         SnippetAttachment[]

  // Composite unique: shortCode per org
  @@unique([id, organizationId])
  @@unique([organizationId, shortCode])
  @@unique([organizationId, autoReplyKind])
  @@index([organizationId, category, isActive])
  @@index([organizationId, teamId, category, isActive])
}

/// A provider-owned WhatsApp template, deliberately separate from
/// MessageTemplate. MessageTemplate is a mutable RabiTech asset; this row
/// carries Meta's identity, approval status, WABA boundary, and immutable
/// provider-shaped components as they were submitted or imported.
model MetaMessageTemplate {
  id                String    @id @default(cuid())
  organizationId    String
  wabaId            String
  providerId        String?
  name              String
  language          String
  category          String
  components        Json
  /// DRAFT locally; otherwise the exact provider status, including unknown
  /// values. Only the exact string APPROVED is sendable in a later phase.
  status            String    @default("DRAFT")
  rejectionReason   String?
  isSupported       Boolean   @default(true)
  unsupportedReason String?
  submittedAt       DateTime?
  lastSyncedAt      DateTime?
  providerUpdatedAt DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  sends        MetaTemplateSend[]

  @@unique([id, organizationId])
  /// Provider ids are only meaningful inside the WABA that owns them.
  @@unique([wabaId, providerId])
  @@index([organizationId, status, archivedAt])
  @@index([organizationId, wabaId, name, language])
}

/// Reservation and delivery ledger for the future template send path.
/// Nothing in phase 1 creates rows here; the schema is established now so
/// approval state can be proven without redesigning the ceiling boundary later.
model MetaTemplateSend {
  id                   String    @id @default(cuid())
  organizationId       String
  templateId           String
  campaignId           String?
  campaignRecipientId  String?
  contactId            String?
  recipientPhone       String
  source               String    @default("MANUAL")
  businessInitiated    Boolean   @default(true)
  status               String    @default("RESERVED")
  providerStatus       String?
  providerMessageId    String?
  reservedAt           DateTime  @default(now())
  reservationExpiresAt DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  releasedAt           DateTime?
  failureReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template          MetaMessageTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  campaign          Campaign?           @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Restrict)
  campaignRecipient CampaignRecipient?  @relation(fields: [campaignRecipientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contact           Contact?            @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, providerMessageId])
  @@index([organizationId, recipientPhone, reservedAt])
  @@index([organizationId, status, reservedAt])
  @@index([organizationId, templateId, reservedAt])
  @@index([organizationId, campaignId])
}

/// A workspace-owned label used only to organize canned replies.
///
/// Topics are deliberately separate from Contact tags: applying a topic to a
/// reply must never alter customer segmentation or trigger a workflow.
model SnippetTopic {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snippets     SnippetTopicAssignment[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model SnippetTopicAssignment {
  organizationId String
  templateId     String
  topicId        String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     MessageTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  topic        SnippetTopic    @relation(fields: [topicId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([organizationId, templateId, topicId])
  @@index([organizationId, topicId, templateId])
}

/// Metadata for a file stored under the workspace's private Snippet upload
/// directory. The signed URL is derived at read time, so rotating the signing
/// secret does not require rewriting database rows.
model SnippetAttachment {
  id             String   @id @default(cuid())
  organizationId String
  templateId     String
  storageKey     String
  fileName       String
  contentType    String
  sizeBytes      Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     MessageTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, storageKey])
  @@unique([organizationId, templateId, fileName])
  @@index([organizationId, templateId, sortOrder])
}

model WorkingHours {
  id                   String   @id @default(cuid())
  organizationId       String
  enabled              Boolean  @default(true)
  autoReplyEnabled     Boolean  @default(true)
  timezone             String   @default("Asia/Jerusalem")
  workDays             Int[]    @default([0, 1, 2, 3, 4])
  startTime            String   @default("08:00")
  endTime              String   @default("20:00")
  outOfHoursTemplateId String?
  welcomeTemplateId    String?
  updatedAt            DateTime @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outOfHoursTemplate MessageTemplate? @relation("OutOfHoursTemplate", fields: [outOfHoursTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  welcomeTemplate    MessageTemplate? @relation("WelcomeTemplate", fields: [welcomeTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId])
}

model CampaignRecipient {
  id             String    @id @default(cuid())
  organizationId String
  campaignId     String
  contactId      String
  status         String    @default("pending")
  sentAt         DateTime?
  error          String?
  /// WhatsApp message id of this recipient's send. Delivery/read acks arrive
  /// later keyed by it — without this a campaign report can never move past "sent".
  waMessageId    String?
  deliveredAt    DateTime?
  readAt         DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign          Campaign           @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact           Contact            @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)
  metaTemplateSends MetaTemplateSend[]

  @@unique([id, organizationId])
  @@unique([organizationId, campaignId, contactId])
  @@index([organizationId])
  // Acks are looked up by waMessageId on every delivery callback.
  @@index([organizationId, waMessageId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g., "conversation.opened", "ticket.created", "message.sent"
  resource       String // e.g., "conversation", "ticket", "contact"
  resourceId     String // e.g., the conversation ID, ticket ID
  changes        Json? // { before: ..., after: ... }
  description    String? // human-readable summary
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, userId, timestamp])
  @@index([organizationId, action, timestamp])
  @@index([organizationId, resourceId])
}

// User-managed keywords that augment the built-in keyword lists used for
// ticket priority detection (IT) and lead categorization (marketing).
model Keyword {
  id             String   @id @default(cuid())
  organizationId String
  category       String // e.g. CRITICAL, HIGH, MEDIUM, LOW, LEAD_SALES, LEAD_INSTALL, LEAD_UPGRADE, LEAD_INQUIRY
  phrase         String
  createdAt      DateTime @default(now())
  createdBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite unique: category + phrase per org
  @@unique([organizationId, category, phrase])
  @@index([organizationId, category])
}

model CsatSurveyResponse {
  id             String    @id @default(cuid())
  organizationId String
  conversationId String
  contactId      String
  assignedToId   String?
  rating         Int? // 1–5, null until customer replies
  feedback       String?
  sentAt         DateTime  @default(now())
  respondedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedTo   User?        @relation(fields: [assignedToId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([conversationId, organizationId])
  @@index([organizationId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  conversationId String?
  title          String
  body           String
  isRead         Boolean          @default(false)
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, userId, isRead, createdAt])
  @@index([organizationId, userId, archivedAt, createdAt])
}

/// A named, saved contact filter. `filter` stores the same DSL the M3 builder
/// produces and `contactWhereFromFilterDsl` compiles.
model Segment {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  /// ContactFilterDsl. Unversioned, exactly like Campaign.audienceFilter — the
  /// DSL is additive by contract, so stored filters keep compiling.
  filter         Json
  /// Who saved it. Audit only: there is no sharing model, so every segment in
  /// an organization is visible to everyone in it.
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Soft delete. Deliberately NOT `isArchived` (the Contact/Conversation
  /// convention): archiving there is a product feature the user sees, this is
  /// deletion, and a timestamp answers "when" for free.
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  // Name uniqueness is a PARTIAL, CASE-INSENSITIVE index created in SQL.
  // Prisma can express neither, so do NOT add @@unique([organizationId, name]) —
  // a full unique index would make a soft-deleted segment reserve its name
  // forever, and re-creating it would be impossible without a manual DB edit.

  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
}

/// Gateway health probe results (H1).
///
/// Append-only and swept after a week. Two probe kinds:
///   `status`   — a plain HTTP call to the gateway. Costs nothing, sends
///                nothing, runs often. Catches a dead or disconnected session.
///   `selfSend` — a real WhatsApp message to the channel's OWN number. Runs
///                rarely. Exists solely to catch outbound failing while the
///                session still reports healthy, which is the fault a status
///                poll is blind to and the one that actually happened.
model GatewayHealthCheck {
  id             String   @id @default(cuid())
  organizationId String
  probe          String
  ok             Boolean
  error          String?
  latencyMs      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, probe, createdAt])
  @@index([createdAt])
}

/// An automation: one trigger, optional conditions, an ordered list of actions.
///
/// `configJson` holds the graph. It is validated in code against the same
/// vocabulary the builder renders, so a stored workflow can never reference an
/// action the executor does not implement.
model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(false)
  triggerType    String
  configJson     Json
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   WorkflowExecution[]
  // Name uniqueness is a case-insensitive SQL index; Prisma cannot express
  // LOWER(name), so do not add @@unique([organizationId, name]).

  deliveryLogs WebhookDeliveryLog[]

  @@unique([id, organizationId])
  @@index([organizationId, triggerType, isActive])
}

/// One run of one workflow. Also the audit trail: what fired, what it did,
/// and why it stopped.
model WorkflowExecution {
  id               String   @id @default(cuid())
  organizationId   String
  workflowId       String
  contactId        String?
  conversationId   String?
  status           String   @default("RUNNING")
  currentStepIndex Int      @default(0)
  /// Capped in code — see MAX_LOG_ENTRIES.
  executionLog     Json?
  error            String?
  /// Loop guard: an action that re-fires its own trigger increments this.
  depth            Int      @default(0)
  /// When an `ASK_QUESTION` step stops waiting for the contact to answer.
  ///
  /// Set only while `status` is `AWAITING_REPLY`. The deadline is enforced by a
  /// delayed BullMQ job — the same mechanism `WAIT_DELAY` already uses — rather
  /// than by a sweep, so an unanswered question costs nothing while it waits.
  /// The column exists so the job can tell "the answer never came" from "the
  /// answer came and this job is a stale duplicate", which it cannot do from
  /// status alone once the run has moved on and paused again.
  awaitingUntil    DateTime?
  /// How many times an `ASK_QUESTION` step has re-asked after an unusable answer.
  /// Separate from `depth`, which guards trigger loops and must not be spent here.
  awaitingAttempts Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow      @relation(fields: [workflowId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId, organizationId], references: [id, organizationId], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  deliveryLogs WebhookDeliveryLog[]

  @@unique([id, organizationId])
  @@index([organizationId, workflowId, createdAt])
  @@index([organizationId, workflowId, contactId, createdAt])
  @@index([createdAt])
  // Read on every inbound message from a contact who has any workflow history,
  // to find a run waiting on their answer. Leads with contactId because status
  // is low-cardinality and would not narrow anything.
  @@index([organizationId, contactId, status])
}

/// Hourly message and conversation counts, per organization.
///
/// Prisma cannot express `date_trunc` in `groupBy` and raw SQL would bypass the
/// tenancy extension, so the buckets are materialised and maintained by
/// `workers/analytics-rollup.worker.ts`, which counts each hour over indexed
/// ranges. A peak-hours heatmap then reads one row per hour rather than one row
/// per message.
model AnalyticsHourly {
  organizationId        String
  hourStart             DateTime
  inbound               Int      @default(0)
  outbound              Int      @default(0)
  automated             Int      @default(0)
  failed                Int      @default(0)
  conversationsCreated  Int      @default(0)
  conversationsResolved Int      @default(0)
  computedAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, hourStart])
  @@index([organizationId, hourStart])
}

/// Every webhook delivery, in both directions.
///
/// OUTBOUND is a workflow `HTTP_WEBHOOK` step calling a subscriber endpoint;
/// INBOUND is the gateway delivering a message to `/webhooks/openwa/:token`.
/// They are separate faults with separate causes — a workflow webhook failing
/// says nothing about whether WhatsApp messages are still arriving — so both
/// live here and the reports split them.
///
/// Highest-volume table in the schema: inbound is one row per received
/// message. Pruned by the analytics rollup worker.
/// A subscriber-configured outbound webhook.
///
/// ## The delivery log is the differentiator
///
/// Respond.io's webhooks have no delivery log and it is an open feature request
/// against them. A webhook you cannot see is a webhook you cannot debug: "did
/// you send it?" is unanswerable by both parties. Deliveries here are written to
/// WebhookDeliveryLog, which already existed for the workflow step.
///
/// ## The secret is stored in clear, unlike an API token
///
/// Not an oversight, and not the same problem. HMAC needs the *same* secret at
/// both ends to compute a signature, so hashing it would make signing
/// impossible. The mitigations are different in kind: it is shown once on
/// creation, rotatable, and scoped to one endpoint rather than the workspace.
model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  /// Shared with the receiver so they can verify. Never returned after creation.
  secret         String
  /// Empty means this endpoint receives nothing — never "everything". An
  /// endpoint subscribed to every event by omission is how a receiver starts
  /// getting message bodies it never asked for.
  events         String[] @default([])

  isActive       Boolean  @default(true)
  /// Switched off after sustained failure. Retrying a dead URL forever costs
  /// the sender and floods the receiver when it comes back.
  disabledAt     DateTime?
  /// Why, in the words the console shows. Respond.io emails you and leaves you
  /// to find the switch; this is what lets the screen answer instead.
  disabledReason String?

  lastDeliveryAt DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?

  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("WebhookEndpointCreatedBy", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, isActive])
}

model WebhookDeliveryLog {
  id             String @id @default(cuid())
  organizationId String

  /// 'OUTBOUND' | 'INBOUND'.
  direction String
  /// Stable identity of the configured endpoint, so repeated deliveries group.
  ///
  /// Two kinds of value live here, and deliberately no foreign key. A workflow
  /// step's identity is synthesised by webhookIdentity(); a configured endpoint
  /// puts its WebhookEndpoint id here directly. A FK would delete the delivery
  /// history the moment an endpoint is removed — and "what did we send them
  /// before you deleted it" is exactly the question asked afterwards.
  webhookId String
  eventType String

  workflowId  String?
  executionId String?

  /// Host only. A full URL can carry a token in its query string, and this is
  /// exactly where that would sit in plaintext forever.
  targetHost String?

  statusCode   Int?
  /// Denormalised: the success rate becomes an indexed count instead of a scan.
  /// A transport error has no status code at all, and is still a failure.
  ok           Boolean @default(false)
  errorMessage String?

  /// Truncated before they reach here — these two carry customer content.
  requestPayload String?
  responseBody   String?

  durationMs Int      @default(0)
  /// Which delivery attempt this was, 1-based. Without it a retry is
  /// indistinguishable from a fresh event, and "we sent it four times" reads as
  /// four separate failures.
  attempt    Int      @default(1)
  createdAt  DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow?          @relation(fields: [workflowId, organizationId], references: [id, organizationId], onDelete: Cascade)
  execution    WorkflowExecution? @relation(fields: [executionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, direction, ok, createdAt])
  @@index([organizationId, webhookId, createdAt])
  @@index([createdAt])
}

/// A stage in the subscriber-defined contact lifecycle.
///
/// `Contact.lifecycleStage` stays a plain string rather than a foreign key:
/// values already exist from hand entry and CSV import that match no stage, and
/// the contact filter DSL treats the column as text — stored campaign audience
/// filters reference it that way, so changing the type would invalidate them.
/// This list drives the selector; a contact holding a value outside it still
/// displays that value rather than appearing blank.
model LifecycleStage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?
  emoji          String?
  /// ACTIVE stages form the sales funnel; LOST stages record drop-off reasons.
  kind           String   @default("ACTIVE")
  /// Exactly one ordinary ACTIVE stage is the automatic entry point for new contacts.
  isDefault      Boolean  @default(false)
  /// Exactly one ACTIVE stage ends the journey as a conversion.
  isWon          Boolean  @default(false)
  /// A lifecycle is a sequence — alphabetical would put Customer before Lead.
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, kind, orderIndex])
}

/// A named conversation filter, private to one agent or shared workspace-wide.
///
/// Saved views filter *conversations*; segments filter *contacts*. They stay
/// separate grammars on purpose — one grammar over both would mean every rule
/// carrying "does this apply to people, threads, or both".
model InboxView {
  id             String   @id @default(cuid())
  organizationId String
  /// Null = shared with the workspace. Set = private to that user.
  ///
  /// A nullable owner rather than a boolean beside an owner: it cannot express
  /// "shared but owned by someone", and the FK does the cleanup — deleting a
  /// user takes their private views and leaves the shared ones standing.
  ownerId        String?
  name           String
  /// An InboxViewFilter. Validated on write; never trusted on read.
  filter         Json
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, ownerId, sortOrder])
}
