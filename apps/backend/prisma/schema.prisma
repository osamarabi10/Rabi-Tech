model Contact {
  id               String           @id @default(cuid())
  organizationId   String
  phone            String
  name             String?
  firstName        String?
  lastName         String?
  email            String?
  language         String?
  profilePic       String?
  countryCode      String?
  lifecycleStage   String?
  assigneeId       String?
  tags             String[]         @default([])
  notes            String?
  isArchived       Boolean          @default(false)
  /// Marketing consent. OPTED_OUT is excluded from every broadcast, always.
  marketingConsent MarketingConsent @default(UNKNOWN)
  /// How consent last changed: keyword | agent | import | api.
  consentSource    String?
  consentUpdatedAt DateTime?
  /// Blocked from reaching this workspace.
  ///
  /// Deliberately NOT `isArchived` and NOT a delete. Archiving hides a contact
  /// from lists and still accepts their messages; deleting them destroys the
  /// conversation history that is usually the entire reason for blocking
  /// someone — harassment, a dispute, a number that will not stop writing. The
  /// history has to survive the block, so this is a third state.
  ///
  /// Enforced in `incoming-message.worker.ts` immediately after the contact
  /// upsert and *before* `getOrCreateActiveConversation`, so a blocked number
  /// cannot open a thread, trigger an auto-reply, consume quota or reach an
  /// agent. Existing threads stay readable, and outbound is not restricted —
  /// an operator may still need to send a final message.
  blockedAt        DateTime?
  blockedReason    String?
  blockedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockedBy          User?                @relation("ContactBlockedBy", fields: [blockedById, organizationId], references: [id, organizationId], onDelete: Restrict)
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  metaTemplateSends  MetaTemplateSend[]
  workflowExecutions WorkflowExecution[]
  csatResponses      CsatSurveyResponse[]
  assignee           User?                @relation("ContactAssignee", fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contactTags        ContactTag[]
  customFieldValues  CustomFieldValue[]
  consentEvents      ConsentEvent[]

  // Composite unique: phone per org
  @@unique([id, organizationId])
  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@index([organizationId, assigneeId])
  @@index([organizationId, marketingConsent])
  @@index([organizationId, lifecycleStage])
  // The inbound worker reads this on every single message that arrives, which
  // makes it the hottest lookup in the schema after phone.
  @@index([organizationId, blockedAt])
}

model Tag {
