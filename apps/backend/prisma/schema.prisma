  notificationAssignment      NotificationDelivery   @default(IN_APP)
  notificationMention         NotificationDelivery   @default(IN_APP)
  notificationResolution      NotificationDelivery   @default(IN_APP)
  notificationEscalation      NotificationDelivery   @default(IN_APP)
  notificationSound           Boolean                @default(true)
